{
  "name": "weblend",
  "type": "module",
  "version": "1.0.0",
  "description": "Web-based 3D creation platform that brings professional 3D tools to your browser",
  "homepage": "https://github.com/imkuldeepahlawat/weblend#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imkuldeepahlawat/weblend.git"
  },
  "author": "Kuldeep Ahlawat <imkuldeepahlawat@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/imkuldeepahlawat/weblend/issues"
  },
  "keywords": [
    "3d",
    "webgl",
    "threejs",
    "blender",
    "modeling",
    "animation",
    "typescript",
    "react"
  ],
  "browserslist": [
    ">0.2%",
    "not dead",
    "not IE 11"
  ],
  "engines": {
    "node": ">=18",
    "yarn": ">=1.22.5"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "prepare": "husky install",
    "precommit": "yarn prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,scss}\" && yarn tsc --noEmit && yarn build"
  },
  "dependencies": {
    "@heroicons/react": "2.1.5",
    "husky": "^9.1.7",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@commitlint/cli": "19.5.0",
    "@eslint/js": "9.13.0",
    "@tailwindcss/forms": "0.5.9",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.3",
    "autoprefixer": "10.4.20",
    "eslint": "9.13.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "eslint-plugin-react-refresh": "0.4.14",
    "lint-staged": "15.2.10",
    "postcss": "8.4.47",
    "prettier": "3.3.3",
    "tailwindcss": "3.4.14",
    "typescript": "5.6.3",
    "typescript-eslint": "8.10.0",
    "vite": "5.4.10",
    "vite-preset-react": "2.3.0"
  }
}
